{
    "name": "LS_SqlServer_OnPrem",
    "properties": {
        "description": "SQL Server 2022 — Docker container simulating on-premises OLTP source.\n                   Uses Self-Hosted Integration Runtime (SHIR) to reach localhost:1433.\n                   In production: replace SHIR with Azure IR + VNet or private endpoint.",
        "type": "SqlServer",
        "typeProperties": {
            "server": "localhost,1433",
            "database": "OmniOC",
            "encrypt": "false",
            "trustServerCertificate": true,
            "authenticationType": "SQL",
            "userName": "SA",
            "password": {
                "type": "AzureKeyVaultSecret",
                "store": {
                    "referenceName": "LS_KeyVault",
                    "type": "LinkedServiceReference"
                },
                "secretName": "sqlserver-password"
            }
        },
        "connectVia": {
            "referenceName": "IR_SelfHosted_OnPrem",
            "type": "IntegrationRuntimeReference"
        },
        "annotations": [
            "project:omnioc-lakehouse",
            "source:sql-server-docker"
        ]
    }
}
