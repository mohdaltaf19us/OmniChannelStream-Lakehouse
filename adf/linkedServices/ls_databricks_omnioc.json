{
    "name": "ls_databricks_omnioc",
    "type": "Microsoft.DataFactory/factories/linkedservices",
    "properties": {
        "description": "Azure Databricks workspace — omnioc-dev-eus-dbw-01. Access token fetched from Key Vault. Used to trigger notebook jobs and DLT pipeline refreshes.",
        "type": "AzureDatabricks",
        "typeProperties": {
            "domain": "https://adb-7405609624004172.12.azuredatabricks.net",
            "accessToken": {
                "type": "AzureKeyVaultSecret",
                "store": {
                    "referenceName": "ls_keyvault_omnioc",
